{
  "name": "@pathableai/pre-ets-frontend-services",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format:check": "dprint check",
    "format:write": "dprint fmt",
    "fallow:health": "fallow health --complexity",
    "fallow:unused": "fallow dead-code",
    "fallow:audit": "fallow audit --gate new-only --gate-marker frontend-services"
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:effect",
    "@effect/platform-node": "catalog:effect",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "effect": "catalog:effect",
    "openid-client": "6.8.8",
    "redis": "6.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:effect",
    "@fast-check/vitest": "0.5.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "next": "16.4.3"
  }
}
