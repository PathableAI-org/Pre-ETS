{
  "name": "@pathableai/pre-ets-frontend-services",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:outage": "vitest run --config vitest.outage.config.ts",
    "lint": "eslint . --max-warnings=0 && pnpm run lint:effect",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "lint:effect": "effect-language-service diagnostics --project tsconfig.json --strict --format text",
    "format:check": "dprint check",
    "format:write": "dprint fmt",
    "fallow:health": "fallow health --complexity",
    "fallow:unused": "fallow dead-code",
    "fallow:audit": "fallow audit --gate new-only --gate-marker frontend-services"
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:effect",
    "@effect/platform-node": "catalog:effect",
    "@opentelemetry/api": "catalog:opentelemetry",
    "@opentelemetry/api-logs": "catalog:opentelemetry",
    "@opentelemetry/exporter-logs-otlp-proto": "catalog:opentelemetry",
    "@opentelemetry/exporter-metrics-otlp-proto": "catalog:opentelemetry",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:opentelemetry",
    "@opentelemetry/instrumentation-http": "catalog:opentelemetry",
    "@opentelemetry/instrumentation-redis": "catalog:opentelemetry",
    "@opentelemetry/instrumentation-runtime-node": "catalog:opentelemetry",
    "@opentelemetry/resources": "catalog:opentelemetry",
    "@opentelemetry/sdk-logs": "catalog:opentelemetry",
    "@opentelemetry/sdk-metrics": "catalog:opentelemetry",
    "@opentelemetry/sdk-node": "catalog:opentelemetry",
    "@opentelemetry/sdk-trace-base": "catalog:opentelemetry",
    "@opentelemetry/sdk-trace-node": "catalog:opentelemetry",
    "@opentelemetry/sdk-trace-web": "catalog:opentelemetry",
    "@opentelemetry/semantic-conventions": "catalog:opentelemetry",
    "effect": "catalog:effect",
    "openid-client": "6.8.9",
    "redis": "6.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "catalog:effect",
    "@fast-check/vitest": "0.5.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "next": "16.4.6"
  }
}
