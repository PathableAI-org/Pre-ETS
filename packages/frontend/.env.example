# Synthetic tenant fixtures for local development. Copy to `.env.local` and restart
# the frontend after any change (tenant files, secrets, or Keycloak recreate).
# `.env.local` is gitignored.
#
# Simplest path: static mode + Compose Keycloak import (docker/keycloak/pre-ets-realm.json).
# Open http://localhost:3000/ → Keycloak login (user `demo` / password `demo`).
#
# Prefer an absolute TENANT_CONFIG_DIR. Relative paths resolve against the process CWD
# at boot (when the filesystem source is constructed), not later working-directory changes.
# Recommend directory permissions limited to the Node process user.
# After editing any `{alias}.json` file, restart so the process-lifetime parse cache refreshes.
#
# Rollback (FR-013): restore the prior release and/or correct the TENANT_CONFIG_DIR
# mount/path. Do not re-enable TENANT_CONFIG_RECORDS_JSON / TENANT_LOCAL_CONFIG_JSON as a
# dual configuration source (those variables are silently ignored if still set).

# Directory of per-tenant `{alias}.json` files (required for host and static config reads).
# Example (absolute; adjust to your checkout):
# TENANT_CONFIG_DIR=/absolute/path/to/packages/frontend/fixtures/tenant-config
TENANT_CONFIG_DIR=

# host (default) or static. Static is development-only; production never reads this.
TENANT_RESOLUTION=static

# Used when TENANT_RESOLUTION=static and NODE_ENV=development. Canonical alias naming the
# file `{TENANT_CONFIG_DIR}/{alias}.json`. Ignored in production.
TENANT_STATIC_ALIAS=springfield

# --- Superseded (silently ignored; no startup diagnostic) ---
# TENANT_CONFIG_RECORDS_JSON=
# TENANT_LOCAL_CONFIG_JSON=

# Server-only client credentials map. Leave empty for public clients.
OIDC_CLIENT_SECRETS_JSON={}

# --- Session store (frontend-owned Redis) ---
REDIS_URL=redis://127.0.0.1:6379

# Required. Generate locally; do not commit a real value:
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
SESSION_SIGNING_SECRET=

SESSION_TTL_SECONDS=86400
SESSION_STORE_TIMEOUT_MS=2000

# Optional Redis key prefix. Production default is pre-ets:session:
# SESSION_KEY_PREFIX=pre-ets:session:

# --- OIDC login transactions ---
# OIDC_TX_KEY_PREFIX=pre-ets:oidc-tx:
# OIDC_TX_TTL_SECONDS=600
# OIDC_TX_SIGNING_SECRET=
