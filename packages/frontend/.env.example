# Synthetic tenant fixtures for local development. Copy to `.env.local` and restart
# the frontend after any change (tenant JSON, secrets, or Keycloak reprovision).
# `.env.local` is gitignored.

# host (default) or static. Static is development-only; production never reads this.
# Unsupported values keep host association and log a safe invalid-mode diagnostic.
TENANT_RESOLUTION=host

# Known records for host association. Each config requires displayName + nested oidc.
# clientAuth is required: "public" | "confidential" (registration mode).
# connection is optional; when set locally it maps to Keycloak kc_idp_hint.
TENANT_CONFIG_RECORDS_JSON=[{"slug":"springfield","config":{"displayName":"Springfield Demo","oidc":{"issuer":"http://127.0.0.1:8080/realms/pre-ets","clientId":"springfield-web","clientAuth":"public","connection":"springfield-idp"}}},{"slug":"shelbyville","config":{"displayName":"Shelbyville Demo","oidc":{"issuer":"http://127.0.0.1:8080/realms/pre-ets","clientId":"shelbyville-web","clientAuth":"public","connection":"shelbyville-idp"}}}]

# Used only when TENANT_RESOLUTION=static and NODE_ENV=development. Supply exactly one record.
# TENANT_LOCAL_CONFIG_JSON={"slug":"springfield","config":{"displayName":"Local Demo","oidc":{"issuer":"http://127.0.0.1:8080/realms/pre-ets","clientId":"springfield-web","clientAuth":"public","connection":"springfield-idp"}}}

# Server-only client credentials map. Required nonempty per slug when that tenant's
# clientAuth is "confidential". Leave empty for public clients. Never commit usable secrets.
# OIDC_CLIENT_SECRETS_JSON={}

# --- Session store (frontend-owned Redis) ---
# Plain redis:// is allowed only for loopback/local Compose. Non-local targets require
# TLS (rediss://) with password authentication (rediss://:password@host:6379).
REDIS_URL=redis://127.0.0.1:6379

# Required. Generate locally; do not commit a real value:
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
# Must be the base64url encoding of at least 32 random bytes. No usable default.
SESSION_SIGNING_SECRET=

# Provisional fixed absolute lifetime in seconds (no sliding renewal). Default 86400.
SESSION_TTL_SECONDS=86400

# Store connect/command deadline in milliseconds. Default 2000; must be a finite
# positive integer within the Node timer-safe range.
SESSION_STORE_TIMEOUT_MS=2000

# Optional Redis key prefix. Production default is pre-ets:session:
# SESSION_KEY_PREFIX=pre-ets:session:

# --- OIDC login transactions (frontend-owned Redis + correlation cookie) ---
# Optional Redis key prefix for short-lived PKCE transactions. Default pre-ets:oidc-tx:
# OIDC_TX_KEY_PREFIX=pre-ets:oidc-tx:

# Optional transaction TTL in seconds. Default 600.
# OIDC_TX_TTL_SECONDS=600

# Optional HS256 signing secret for the pathable-oidc correlation cookie.
# If unset, SESSION_SIGNING_SECRET is reused.
# OIDC_TX_SIGNING_SECRET=
