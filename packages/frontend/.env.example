# Synthetic tenant fixtures for local development. Copy to `.env.local` and restart
# the frontend after any change (tenant JSON, secrets, or Keycloak recreate).
# `.env.local` is gitignored.
#
# Simplest path: static mode + Compose Keycloak import (docker/keycloak/pre-ets-realm.json).
# Open http://localhost:3000/ → Keycloak login (user `demo` / password `demo`).

# host (default) or static. Static is development-only; production never reads this.
TENANT_RESOLUTION=static

# Used when TENANT_RESOLUTION=static and NODE_ENV=development. Exactly one record.
# No `connection` / kc_idp_hint — Keycloak shows its built-in login form.
TENANT_LOCAL_CONFIG_JSON={"slug":"springfield","config":{"displayName":"Local Demo","oidc":{"issuer":"http://127.0.0.1:8080/realms/pre-ets","clientId":"springfield-web","clientAuth":"public"}}}

# Known records for host association (springfield.localhost / shelbyville.localhost).
# Unused while TENANT_RESOLUTION=static. Omit `connection` unless you add matching IdPs.
TENANT_CONFIG_RECORDS_JSON=[{"slug":"springfield","config":{"displayName":"Springfield Demo","oidc":{"issuer":"http://127.0.0.1:8080/realms/pre-ets","clientId":"springfield-web","clientAuth":"public"}}},{"slug":"shelbyville","config":{"displayName":"Shelbyville Demo","oidc":{"issuer":"http://127.0.0.1:8080/realms/pre-ets","clientId":"shelbyville-web","clientAuth":"public"}}}]

# Server-only client credentials map. Leave empty for public clients.
OIDC_CLIENT_SECRETS_JSON={}

# --- Session store (frontend-owned Redis) ---
REDIS_URL=redis://127.0.0.1:6379

# Required. Generate locally; do not commit a real value:
#   node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
SESSION_SIGNING_SECRET=

SESSION_TTL_SECONDS=86400
SESSION_STORE_TIMEOUT_MS=2000

# Optional Redis key prefix. Production default is pre-ets:session:
# SESSION_KEY_PREFIX=pre-ets:session:

# --- OIDC login transactions ---
# OIDC_TX_KEY_PREFIX=pre-ets:oidc-tx:
# OIDC_TX_TTL_SECONDS=600
# OIDC_TX_SIGNING_SECRET=
