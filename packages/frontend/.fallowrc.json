{
  "$schema": "../../node_modules/fallow/schema.json",
  "extends": "../../.fallowrc.shared.json",
  "production": {
    "deadCode": true
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/next-env.d.ts"
  ],
  "health": {
    "thresholdOverrides": [
      {
        "files": [
          "src/components/onsite/visit-state.ts"
        ],
        "functions": [
          "transitionVisit"
        ],
        "maxCyclomatic": 15,
        "reason": "Exhaustive discriminated-union action dispatcher; cognitive complexity remains within the global ceiling."
      }
    ]
  },
  "rules": {
    "unused-dependencies": "error"
  }
}
