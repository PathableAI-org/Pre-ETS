{
  "name": "@pathableai/pre-ets-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @pathableai/pre-ets-domain build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @pathableai/pre-ets-domain build && tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "pnpm --filter @pathableai/pre-ets-domain build && eslint . --max-warnings=0",
    "lint:fix": "pnpm --filter @pathableai/pre-ets-domain build && eslint . --max-warnings=0 --fix",
    "format:check": "dprint check",
    "format:write": "dprint fmt",
    "fallow:health": "fallow health --complexity",
    "fallow:unused": "fallow dead-code",
    "fallow:audit": "fallow audit --gate new-only --gate-marker backend"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:effect",
    "@pathableai/pre-ets-domain": "workspace:*",
    "effect": "catalog:effect",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
