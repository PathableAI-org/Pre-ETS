{
  "$schema": "./node_modules/fallow/schema.json",
  "minimumVersion": "3.34.1",
  "typeAware": {
    "enabled": true,
    "projects": ["tsconfig.json"],
    "require": "best-effort"
  },
  "duplicates": {
    "mode": "semantic"
  },
  "similarCode": {
    "ignore": ["**/.next/**", "**/dist/**", "**/coverage/**", "**/build/**"]
  },
  "health": {
    "maxCyclomatic": 10,
    "maxCognitive": 10,
    "maxCrap": 30,
    "maxUnitSize": 60,
    "suggestInlineSuppression": false
  },
  "rules": {
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error",
    "private-type-leaks": "error",
    "require-suppression-reason": "error"
  }
}
