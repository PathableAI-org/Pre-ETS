{
  "$schema": "./node_modules/fallow/schema.json",
  "extends": "./.fallowrc.shared.json",
  "entry": [
    "cucumber.mjs",
    "cucumber.smoke.mjs",
    "tests/bdd/steps/*.ts",
    "tests/bdd/support/hooks.ts",
    "tests/bdd/support/world.ts",
    "tests/bdd/checks/*.test.*"
  ],
  "ignorePatterns": [
    "packages/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/next-env.d.ts"
  ],
  "ignoreDependencies": [
    "@effect/platform-node",
    "effect"
  ],
  "health": {
    "thresholdOverrides": [
      {
        "files": [
          "tests/bdd/support/server.ts"
        ],
        "functions": [
          "response.on(\"end\")",
          "signalProcessGroup",
          "stopSite",
          "waitUntilReady"
        ],
        "maxCrap": 60,
        "reason": "Cucumber executes this support code dynamically, so static test reachability undercounts its behavioral coverage; global cyclomatic and cognitive ceilings still apply."
      }
    ]
  },
  "rules": {
    "unused-dependencies": "error"
  },
  "framework": [
    {
      "name": "dprint-npm-plugins",
      "enablers": [
        "dprint"
      ],
      "configPatterns": [
        "dprint.json"
      ],
      "toolingDependencies": [
        "@dprint/typescript",
        "@dprint/json",
        "@dprint/markdown",
        "dprint-plugin-yaml"
      ]
    },
    {
      "name": "effect-language-service-schema",
      "enablers": [
        "@effect/language-service"
      ],
      "configPatterns": [
        "tsconfig.effect.json"
      ],
      "toolingDependencies": [
        "@effect/language-service"
      ]
    }
  ]
}
