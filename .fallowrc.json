{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "packages/backend/src/index.ts",
    "packages/frontend/src/app/layout.tsx",
    "packages/frontend/src/app/page.tsx"
  ],
  "workspaces": {
    "patterns": [
      "packages/*"
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/next-env.d.ts"
  ],
  "rules": {
    "unused-dependencies": "error"
  },
  "framework": [
    {
      "name": "dprint-npm-plugins",
      "enablers": [
        "dprint"
      ],
      "configPatterns": [
        "dprint.json",
        "packages/*/dprint.json"
      ],
      "toolingDependencies": [
        "@dprint/typescript",
        "@dprint/json",
        "@dprint/markdown",
        "dprint-plugin-yaml"
      ]
    }
  ]
}
