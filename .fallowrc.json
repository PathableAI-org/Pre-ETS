{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "packages/*/src/index.ts"
  ],
  "workspaces": {
    "patterns": [
      "packages/*"
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**"
  ],
  "rules": {
    "unused-dependencies": "error"
  }
}
