{
  "name": "@pathableai/pre-ets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:frontend": "pnpm --filter @pathableai/pre-ets-frontend start",
    "start:backend": "pnpm --filter @pathableai/pre-ets-backend start",
    "build": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "lint": "eslint \"*.js\" --max-warnings=0 && pnpm --filter \"./packages/*\" run lint",
    "lint:fix": "eslint \"*.js\" --max-warnings=0 --fix && pnpm --filter \"./packages/*\" run lint:fix",
    "fallow": "fallow",
    "check:unused": "fallow dead-code",
    "format:check": "dprint check \"*\" && pnpm --filter \"./packages/*\" run format:check",
    "format:write": "dprint fmt \"*\" && pnpm --filter \"./packages/*\" run format:write",
    "prepare": "husky",
    "check:changes": "fallow audit --gate new-only --gate-marker pre-commit"
  },
  "devDependencies": {
    "@dprint/json": "0.23.0",
    "@dprint/markdown": "0.24.0",
    "@dprint/typescript": "0.96.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "dprint": "0.57.4",
    "dprint-plugin-yaml": "0.6.0",
    "eslint": "10.10.0",
    "eslint-plugin-perfectionist": "5.11.0",
    "fallow": "3.25.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
