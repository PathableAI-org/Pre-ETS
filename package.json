{
  "name": "@pathableai/pre-ets",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:frontend": "pnpm --filter @pathableai/pre-ets-frontend start",
    "start:backend": "pnpm --filter @pathableai/pre-ets-backend start",
    "dev:frontend": "pnpm --filter @pathableai/pre-ets-frontend dev",
    "build": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter \"./packages/*\" run typecheck",
    "lint": "eslint \"*.js\" \"*.mjs\" tests --max-warnings=0 && pnpm --filter \"./packages/*\" run lint",
    "lint:fix": "eslint \"*.js\" \"*.mjs\" tests --max-warnings=0 --fix && pnpm --filter \"./packages/*\" run lint:fix",
    "test:bdd:dry": "CUCUMBER_SESSION=1 CUCUMBER_OIDC=1 cucumber-js --config cucumber.mjs --dry-run",
    "test:bdd": "CUCUMBER_REPORT=cucumber-production cucumber-js --config cucumber.mjs --tags '@production' && CUCUMBER_REPORT=cucumber-remaining cucumber-js --config cucumber.mjs --tags 'not @production'",
    "test:bdd:session": "CUCUMBER_SESSION=1 CUCUMBER_REPORT=cucumber-session cucumber-js --config cucumber.mjs --tags '@session-setup'",
    "test:bdd:session:contract": "CUCUMBER_SESSION=1 CUCUMBER_REPORT=cucumber-session-contract cucumber-js --config cucumber.mjs --tags '@session-setup and @contract and not @http'",
    "test:bdd:oidc": "CUCUMBER_OIDC=1 CUCUMBER_REPORT=cucumber-oidc cucumber-js --config cucumber.mjs --tags '@tenant-oidc-login'",
    "fallow": "fallow",
    "check:unused": "fallow dead-code",
    "format:check": "dprint check \"*\" .github docs tests && pnpm --filter \"./packages/*\" run format:check",
    "format:write": "dprint fmt \"*\" .github docs tests && pnpm --filter \"./packages/*\" run format:write",
    "prepare": "husky",
    "check:changes": "fallow audit --gate new-only --gate-marker pre-commit"
  },
  "devDependencies": {
    "@dprint/json": "0.23.0",
    "@dprint/markdown": "0.24.0",
    "@dprint/typescript": "0.96.1",
    "@eslint/js": "10.0.1",
    "@cucumber/cucumber": "13.2.1",
    "@types/node": "24.13.5",
    "dprint": "0.57.4",
    "dprint-plugin-yaml": "0.6.0",
    "eslint": "10.10.0",
    "eslint-plugin-perfectionist": "5.11.0",
    "fallow": "3.25.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
