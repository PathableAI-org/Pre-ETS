{
  "name": "@pathableai/pre-ets",
  "private": true,
  "type": "module",
  "scripts": {
    "start:frontend": "pnpm --filter @pathableai/pre-ets-frontend start",
    "start:backend": "pnpm --filter @pathableai/pre-ets-backend start",
    "dev:frontend": "pnpm --filter @pathableai/pre-ets-frontend dev",
    "build": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter \"./packages/*\" run typecheck",
    "lint": "eslint \"*.js\" \"*.mjs\" tests --max-warnings=0 && pnpm --filter \"./packages/*\" run lint && pnpm lint:gherkin",
    "lint:fix": "eslint \"*.js\" \"*.mjs\" tests --max-warnings=0 --fix && pnpm --filter \"./packages/*\" run lint:fix && pnpm lint:gherkin",
    "fallow": "fallow",
    "check:health": "pnpm --include-workspace-root --no-bail run --parallel fallow:health",
    "check:unused": "pnpm --include-workspace-root --no-bail run --parallel fallow:unused",
    "format:check": "dprint check \"*\" .github docs tests && pnpm --filter \"./packages/*\" run format:check && pnpm format:gherkin:check",
    "format:write": "dprint fmt \"*\" .github docs tests && pnpm --filter \"./packages/*\" run format:write && pnpm format:gherkin:write",
    "prepare": "husky",
    "check:changes": "pnpm --include-workspace-root --no-bail run --parallel fallow:audit",
    "test:bdd": "pnpm --filter @pathableai/pre-ets-frontend build && cucumber-js --config cucumber.mjs",
    "test:bdd:smoke": "cucumber-js --config cucumber.smoke.mjs",
    "test:bdd:dry": "cucumber-js --config cucumber.mjs --dry-run",
    "test:bdd:checks": "node --test tests/bdd/checks/*.test.*",
    "lint:gherkin": "gherkin-lint --config .gherkin-lintrc \"tests/bdd/requirements/**/*.feature\"",
    "format:gherkin:check": "prettier --no-config --no-editorconfig --plugin prettier-plugin-gherkin --tab-width 2 --end-of-line lf --print-width 120 --check \"tests/bdd/requirements/**/*.feature\"",
    "format:gherkin:write": "prettier --no-config --no-editorconfig --plugin prettier-plugin-gherkin --tab-width 2 --end-of-line lf --print-width 120 --write \"tests/bdd/requirements/**/*.feature\"",
    "fallow:health": "fallow health --complexity",
    "fallow:unused": "fallow dead-code",
    "fallow:audit": "fallow audit --gate new-only --gate-marker root"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:effect",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@dprint/json": "0.25.2",
    "@dprint/markdown": "0.28.2",
    "@dprint/typescript": "0.96.1",
    "@effect/language-service": "0.87.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "dprint": "0.64.3",
    "dprint-plugin-yaml": "0.6.0",
    "eslint": "10.13.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "fallow": "3.35.0",
    "gherkin-refine": "1.4.6",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-gherkin": "4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  }
}
