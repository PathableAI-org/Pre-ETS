{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git worktree list *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:effect)",
      "Bash(pnpm lint:gherkin)",
      "Bash(pnpm format:check)",
      "Bash(pnpm format:gherkin:check)",
      "Bash(pnpm check:unused)",
      "Bash(pnpm check:health)",
      "Bash(pnpm check:changes)",
      "Bash(pnpm test:bdd:dry)",
      "Bash(pnpm test:tooling)",
      "Bash(pnpm verify:gate)",
      "Bash(pnpm verify:request *)",
      "Bash(pnpm verify:show)",
      "Bash(pnpm verify:show *)",
      "Bash(pnpm verify:render)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:unit *)",
      "Bash(pnpm test:integration *)",
      "Bash(pnpm --filter @pathableai/pre-ets-backend test *)",
      "Bash(pnpm --filter @pathableai/pre-ets-domain test *)",
      "Bash(pnpm --filter @pathableai/pre-ets-frontend test:unit *)",
      "Bash(pnpm --filter @pathableai/pre-ets-frontend-services test *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh stack view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh stack merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh pr ready *)",
      "Bash(gh stack unstack *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Edit(**/eslint.config.js)",
      "Edit(/eslint.effect.js)",
      "Edit(**/tsconfig*.json)",
      "Edit(**/.fallowrc*.json)",
      "Edit(**/dprint.json)",
      "Edit(**/lint-staged.config.js)",
      "Edit(/.husky/**)",
      "Edit(/.claude/settings.json)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --mirror *)",
      "Bash(git push * --mirror *)",
      "Bash(git push --prune *)",
      "Bash(git push * --prune *)",
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard)",
      "Bash(git reset * --hard *)",
      "Bash(git * --output*)",
      "Bash(git * --ext-diff*)",
      "Bash(git * --upload-pack*)",
      "Bash(git * --receive-pack*)",
      "Bash(git diff --no-index *)",
      "Bash(git diff * --no-index *)",
      "Bash(gh stack modify *)",
      "Bash(gh stack submit)",
      "Bash(gh repo delete *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(set)",
      "Bash(export)",
      "Bash(export -p)",
      "Read(//proc/*/environ)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/pr-ready-hook.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
