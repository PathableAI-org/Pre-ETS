{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':combinePatchMinorReleases',
    'helpers:pinGitHubActionDigests',
    'schedule:nonOfficeHours',
  ],
  timezone: 'America/New_York',
  automerge: true,
  automergeType: 'pr',
  platformAutomerge: true,
  enabledManagers: [
    'npm',
    'github-actions',
    'docker-compose',
    'dockerfile',
    'nodenv',
    'custom.regex',
  ],
  labels: ['dependencies', 'renovate'],
  prConcurrentLimit: 8,
  prHourlyLimit: 2,
  rebaseWhen: 'behind-base-branch',
  separateMajorMinor: true,
  lockFileMaintenance: {
    enabled: true,
    schedule: ['* 0-4 * * 6'],
    groupName: 'pnpm lockfile maintenance',
    addLabels: ['lockfile'],
  },
  vulnerabilityAlerts: {
    labels: ['dependencies', 'renovate', 'security'],
  },
  customManagers: [
    {
      customType: 'regex',
      description:
        'Keep package.json engines.node aligned with the .node-version major.',
      managerFilePatterns: ['/(^|/)package\\.json$/'],
      matchStrings: [
        '"engines"\\s*:\\s*\\{[\\s\\S]*?"node"\\s*:\\s*">=(?<currentValue>\\d+(?:\\.\\d+)*)"',
      ],
      datasourceTemplate: 'node-version',
      depNameTemplate: 'node',
      versioningTemplate: 'node',
    },
  ],
  packageRules: [
    // Residual first; later groupName rules override for Effect / React / lint / test.
    {
      description:
        'Group remaining non-major pnpm workspace dependency updates into a reviewable batch.',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'pnpm non-major dependencies',
      groupSlug: 'pnpm-non-major',
      addLabels: ['javascript', 'pnpm'],
    },
    {
      description:
        'Keep Effect and @effect/* on a coordinated non-major PR; never auto-merge RC lockstep bumps.',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      matchPackageNames: ['effect', '/^@effect\\//', 'effect-solutions'],
      groupName: 'effect ecosystem',
      groupSlug: 'effect-ecosystem',
      automerge: false,
      addLabels: ['javascript', 'pnpm', 'effect'],
    },
    {
      description:
        'Keep React / Next stack non-majors together for regression triage; never auto-merge.',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      matchPackageNames: [
        'react',
        'react-dom',
        '@types/react',
        '@types/react-dom',
        'next',
        '@next/eslint-plugin-next',
      ],
      groupName: 'react next stack',
      groupSlug: 'react-next-stack',
      automerge: false,
      addLabels: ['javascript', 'pnpm', 'framework'],
    },
    {
      description: 'Group non-major lint and format toolchain updates (safe to auto-merge).',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      matchPackageNames: [
        'eslint',
        '/^@eslint\\//',
        'typescript-eslint',
        '/^@typescript-eslint\\//',
        'prettier',
        'eslint-plugin-perfectionist',
        'eslint-plugin-react-hooks',
        'eslint-plugin-jsx-a11y-x',
        'eslint-plugin-playwright',
        '@eslint-react/eslint-plugin',
      ],
      groupName: 'lint and format',
      groupSlug: 'lint-and-format',
      addLabels: ['javascript', 'pnpm', 'lint'],
    },
    {
      description:
        'Group non-major test and e2e runner updates; never auto-merge (CI / runner coupling).',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      matchPackageNames: [
        'vitest',
        'vite',
        '@vitejs/plugin-react',
        '@playwright/test',
        'puppeteer-core',
        'axe-core',
      ],
      groupName: 'test and e2e',
      groupSlug: 'test-and-e2e',
      automerge: false,
      addLabels: ['javascript', 'pnpm', 'test'],
    },
    {
      description:
        'Keep PathAble React non-majors on their own PR; never auto-merge (special / private dependency).',
      matchManagers: ['npm'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      matchPackageNames: ['@pathableai/react'],
      groupName: 'pathable react',
      groupSlug: 'pathable-react',
      automerge: false,
      addLabels: ['javascript', 'pnpm', 'pathable'],
    },
    {
      description: 'Keep major JavaScript dependency upgrades isolated for easier regression triage.',
      matchManagers: ['npm'],
      matchUpdateTypes: ['major'],
      addLabels: ['javascript', 'pnpm', 'major'],
    },
    {
      description:
        'Keep Vite / Vitest / @vitejs majors in one PR so tests stay on a single Vite major.',
      matchManagers: ['npm'],
      matchUpdateTypes: ['major'],
      matchPackageNames: ['vite', 'vitest', '/^@vitest\\//', '/^@vitejs\\//'],
      groupName: 'vite vitest stack',
      groupSlug: 'vite-vitest-stack',
      automerge: false,
      addLabels: ['javascript', 'pnpm', 'test', 'major'],
    },
    {
      description: 'Group non-major GitHub Action SHA and version-comment refreshes.',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'github actions non-major updates',
      groupSlug: 'github-actions-non-major',
      addLabels: ['ci', 'github-actions'],
    },
    {
      description: 'Keep major GitHub Action upgrades separate.',
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['major'],
      addLabels: ['ci', 'github-actions', 'major'],
    },
    {
      description: 'Group non-major Docker base image refreshes.',
      matchManagers: ['dockerfile', 'docker-compose'],
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      groupName: 'docker non-major updates',
      groupSlug: 'docker-non-major',
      addLabels: ['docker'],
    },
    {
      description:
        'Keep Node runtime pins coordinated (.node-version, engines, Docker node images, @types/node).',
      matchManagers: ['nodenv', 'dockerfile', 'npm', 'custom.regex'],
      matchPackageNames: ['node', '@types/node'],
      groupName: 'node runtime',
      groupSlug: 'node-runtime',
      automerge: false,
      addLabels: ['javascript', 'node'],
    },
    {
      description: 'Never auto-merge major version upgrades.',
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    {
      description: 'Defer TypeScript major upgrades until typescript-eslint supports them.',
      matchManagers: ['npm'],
      matchPackageNames: ['typescript'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],
}
