{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":combinePatchMinorReleases",
    "helpers:pinGitHubActionDigests",
    "schedule:nonOfficeHours",
  ],
  "timezone": "America/New_York",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  // Let Renovate wait for all checks, including those not required by GitHub.
  "platformAutomerge": false,
  "ignoreTests": false,
  "enabledManagers": [
    "npm",
    "github-actions",
    "docker-compose",
    "dockerfile",
    "nodenv",
  ],
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 8,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "separateMajorMinor": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * 6"],
    "groupName": "pnpm lockfile maintenance",
    "addLabels": ["lockfile"],
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "renovate", "security"],
  },
  "packageRules": [
    {
      "description": "Wait for pnpm's one-day cooldown, including companion package publication lag, and deduplicate the resulting lockfile.",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBuffer": "1 hour",
      "internalChecksFilter": "strict",
      "rangeStrategy": "pin",
      "postUpdateOptions": ["pnpmDedupe"],
    },
    // Residual first; later groupName rules select the owning dependency set.
    {
      "description": "Group remaining non-major pnpm workspace dependency updates into a reviewable batch.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "pnpm non-major dependencies",
      "groupSlug": "pnpm-non-major",
      "addLabels": ["javascript", "pnpm"],
    },
    {
      "description": "Keep Effect and @effect/* catalog updates coordinated.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": ["effect", "/^@effect\\//"],
      "groupName": "effect ecosystem",
      "groupSlug": "effect-ecosystem",
      "addLabels": ["javascript", "pnpm", "effect"],
    },
    {
      "description": "Keep React / Next stack non-majors together for regression triage.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "next",
        "@next/eslint-plugin-next",
      ],
      "groupName": "react next stack",
      "groupSlug": "react-next-stack",
      "addLabels": ["javascript", "pnpm", "framework"],
    },
    {
      "description": "Coordinate OpenTelemetry API, SDK, experimental packages, instrumentation, and semantic conventions, including majors, so one release line lands together. The ceilings below stay inside the installed @effect/opentelemetry peer ranges. Remove them when that package accepts the next SDK and the frontend no longer depends on @opentelemetry/sdk-trace-base, sdk-trace-node, or sdk-trace-web.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": ["/^@opentelemetry\\//", "@vercel/otel"],
      "groupName": "opentelemetry stack",
      "groupSlug": "opentelemetry-stack",
      "addLabels": ["javascript", "pnpm", "observability"],
    },
    {
      "description": "Keep an OpenTelemetry major on the same branch as the API and experimental updates from that release.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@opentelemetry\\//", "@vercel/otel"],
      "separateMajorMinor": false,
    },
    {
      "description": "SDK 2.12 rejects @opentelemetry/api 1.10.0, which ships with SDK 3.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@opentelemetry/api"],
      "allowedVersions": "<1.10.0",
    },
    {
      "description": "Keep experimental OpenTelemetry packages on the 0.2xx line. 0.300.0 aligns with SDK 3, and a jump such as sdk-logs 0.223.0 to 3.0.0 falls outside this range.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@opentelemetry/api-logs",
        "@opentelemetry/exporter-trace-otlp-http",
        "@opentelemetry/exporter-trace-otlp-proto",
        "@opentelemetry/instrumentation",
        "@opentelemetry/sdk-logs",
      ],
      "allowedVersions": "<0.300.0",
    },
    {
      "description": "Keep the stable OpenTelemetry SDK on 2.x until the Effect wrapper accepts SDK 3.",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@opentelemetry/resources",
        "@opentelemetry/sdk-metrics",
        "@opentelemetry/sdk-trace-base",
        "@opentelemetry/sdk-trace-node",
        "@opentelemetry/sdk-trace-web",
      ],
      "allowedVersions": "<3.0.0",
    },
    {
      "description": "Match @effect/opentelemetry's peer cap on semantic conventions.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@opentelemetry/semantic-conventions"],
      "allowedVersions": "<2.0.0",
    },
    {
      "description": "Coordinate non-major ESLint, TypeScript, typescript-eslint, plugins, and globals updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": [
        "eslint",
        "/^@eslint\\//",
        "/^@eslint-community\\//",
        "typescript",
        "typescript-eslint",
        "/^@typescript-eslint\\//",
        "globals",
        "/^eslint-plugin-/",
        "/^@eslint-react\\//",
      ],
      "groupName": "eslint toolchain",
      "groupSlug": "eslint-toolchain",
      "addLabels": ["javascript", "pnpm", "lint"],
    },
    {
      "description": "Coordinate non-major dprint formatter, plugins, and platform binary updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": ["dprint", "/^@dprint\\//", "/^dprint-plugin-/"],
      "groupName": "dprint formatting",
      "groupSlug": "dprint-formatting",
      "addLabels": ["javascript", "pnpm", "formatting"],
    },
    {
      "description": "Coordinate non-major Prettier formatter and plugin updates.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": ["prettier", "/^prettier-plugin-/", "/^@prettier\\//"],
      "groupName": "prettier formatting",
      "groupSlug": "prettier-formatting",
      "addLabels": ["javascript", "pnpm", "formatting"],
    },
    {
      "description": "Keep non-major Git hook tooling updates separate from lint and formatting engines.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": ["husky", "lint-staged"],
      "groupName": "git hook tooling",
      "groupSlug": "git-hook-tooling",
      "addLabels": ["javascript", "pnpm", "tooling"],
    },
    {
      "description": "Group non-major test runner and browser library updates for CI / runner compatibility.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": [
        "vitest",
        "/^@vitest\\//",
        "@fast-check/vitest",
        "fast-check",
        "vite",
        "@vitejs/plugin-react",
        "playwright",
        "puppeteer-core",
        "axe-core",
      ],
      "groupName": "test and e2e",
      "groupSlug": "test-and-e2e",
      "addLabels": ["javascript", "pnpm", "test"],
    },
    {
      "description": "Keep PathAble React non-majors on their own PR (special / private dependency).",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "matchPackageNames": ["@pathableai/react"],
      "groupName": "pathable react",
      "groupSlug": "pathable-react",
      "addLabels": ["javascript", "pnpm", "pathable"],
    },
    {
      "description": "Keep major JavaScript dependency upgrades isolated for easier regression triage.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["javascript", "pnpm", "major"],
    },
    {
      "description": "Keep Vite / Vitest / @vitejs majors in one PR so tests stay on a single Vite major.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["vite", "vitest", "/^@vitest\\//", "/^@vitejs\\//"],
      "groupName": "vite vitest stack",
      "groupSlug": "vite-vitest-stack",
      "addLabels": ["javascript", "pnpm", "test", "major"],
    },
    {
      "description": "Group non-major GitHub Action SHA and version-comment refreshes.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github actions non-major updates",
      "groupSlug": "github-actions-non-major",
      "addLabels": ["ci", "github-actions"],
    },
    {
      "description": "Keep major GitHub Action upgrades separate.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["ci", "github-actions", "major"],
    },
    {
      "description": "Group non-major Docker base image refreshes.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "docker non-major updates",
      "groupSlug": "docker-non-major",
      "addLabels": ["docker"],
    },
    {
      "description": "Keep Node runtime pins coordinated (.node-version, engines, Docker node images, @types/node).",
      "matchManagers": ["nodenv", "dockerfile", "npm"],
      "matchPackageNames": ["node", "@types/node"],
      "groupName": "node runtime",
      "groupSlug": "node-runtime",
      "separateMajorMinor": false,
      "addLabels": ["javascript", "node"],
    },
    {
      "description": "Preserve the Node engine minimum instead of pinning it to an exact runtime version.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "rangeStrategy": "replace",
    },
    {
      "description": "Defer TypeScript major upgrades until typescript-eslint supports them.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },
  ],
}
